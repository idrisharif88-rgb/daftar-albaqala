# Copy this to ".env.test" wherever you run the tests (git-ignored).
# Tests run against a SEPARATE database (daftar_test) — NEVER production daftar_db.
# The tests refuse to run unless DB_NAME is exactly "daftar_test".

DB_HOST=localhost
DB_PORT=3306
DB_USER=daftar_user
DB_PASSWORD=
DB_NAME=daftar_test

# Any random string — tests sign their own login tokens with this.
JWT_SECRET=test-secret-not-a-real-key
