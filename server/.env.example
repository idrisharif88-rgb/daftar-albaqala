# Copy this file to ".env" on the server and fill in the real values.
# .env is git-ignored — real secrets never go to GitHub.

# --- Server ---
PORT=3002

# --- Database (MySQL on this server) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=daftar_user
DB_PASSWORD=
DB_NAME=daftar_db

# --- Auth ---
# A long random string used to sign login tokens (set in Phase 3).
JWT_SECRET=

# --- Attachments (files pinned to entries) ---
# Where uploaded files are stored on disk. Use a path OUTSIDE the git clone so
# `git pull` never touches it, e.g. /var/lib/daftar/attachments (the owner
# creates it and chowns it to the user pm2 runs as). If unset it defaults to
# ./data/attachments under the server's working directory.
ATTACH_DIR=

# --- Admin (the Watcher app) ---
# Generate all four with:  npx tsx scripts/admin-setup.ts
# Leave them empty and /admin stays closed (503).
ADMIN_PHONE=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
ADMIN_JWT_SECRET=
