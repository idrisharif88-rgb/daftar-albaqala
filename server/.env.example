# Copy this file to ".env" on the server and fill in the real values.
# .env is git-ignored — real secrets never go to GitHub.

# --- Server ---
PORT=3002

# --- Database (MySQL on this server) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=daftar_user
DB_PASSWORD=
DB_NAME=daftar_db

# --- Auth ---
# A long random string used to sign login tokens (set in Phase 3).
JWT_SECRET=
