<?xml version="1.0" encoding="utf-8"?>
<!-- Grocer's ledger + coin. 108x108 viewport; artwork kept within the
     center safe zone so launcher masks don't clip it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108">

    <!-- spiral binding wires (drawn under the page top edge) -->
    <path android:strokeColor="#B9AC93" android:strokeWidth="2.6"
        android:strokeLineCap="round" android:pathData="M39,22 L43,31" />
    <path android:strokeColor="#B9AC93" android:strokeWidth="2.6"
        android:strokeLineCap="round" android:pathData="M47,22 L51,31" />
    <path android:strokeColor="#B9AC93" android:strokeWidth="2.6"
        android:strokeLineCap="round" android:pathData="M55,22 L59,31" />
    <path android:strokeColor="#B9AC93" android:strokeWidth="2.6"
        android:strokeLineCap="round" android:pathData="M63,22 L67,31" />
    <path android:strokeColor="#B9AC93" android:strokeWidth="2.6"
        android:strokeLineCap="round" android:pathData="M71,22 L75,31" />

    <!-- notebook page (cream, rounded) -->
    <path android:fillColor="#FBF3E3"
        android:pathData="M37,26 H71 A5,5 0 0 1 76,31 V79 A5,5 0 0 1 71,84 H37 A5,5 0 0 1 32,79 V31 A5,5 0 0 1 37,26 Z" />

    <!-- red margin rule (accountant's ledger line) -->
    <path android:strokeColor="#E24C4B" android:strokeWidth="2"
        android:strokeLineCap="round" android:pathData="M40,33 L40,77" />

    <!-- ruled lines -->
    <path android:strokeColor="#9DB6C7" android:strokeWidth="2"
        android:strokeLineCap="round" android:pathData="M44,41 L71,41" />
    <path android:strokeColor="#9DB6C7" android:strokeWidth="2"
        android:strokeLineCap="round" android:pathData="M44,49 L71,49" />
    <path android:strokeColor="#9DB6C7" android:strokeWidth="2"
        android:strokeLineCap="round" android:pathData="M44,57 L71,57" />
    <path android:strokeColor="#9DB6C7" android:strokeWidth="2"
        android:strokeLineCap="round" android:pathData="M44,65 L64,65" />

    <!-- gold coin (overlaps the page's bottom-right corner) -->
    <path android:fillColor="#F6C445"
        android:pathData="M57,73 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 Z" />
    <path android:strokeColor="#DBA400" android:strokeWidth="2"
        android:pathData="M61,73 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 Z" />
    <!-- highlight -->
    <path android:fillColor="#FFE9A8"
        android:pathData="M61.5,68 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 Z" />
