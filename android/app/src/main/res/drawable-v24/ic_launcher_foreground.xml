<?xml version="1.0" encoding="utf-8"?>
<!-- Grocer's ledger + coin, simplified for icon use. 108x108 viewport.
     Everything sits inside the centre 66dp safe circle, so round launcher
     masks clip nothing (the old spiral binding sat on the boundary). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108">

    <!-- page -->
    <path android:fillColor="#FBF3E3"
        android:pathData="M39,31 H69 A5,5 0 0 1 74,36 V72 A5,5 0 0 1 69,77 H39 A5,5 0 0 1 34,72 V36 A5,5 0 0 1 39,31 Z" />

    <!-- red margin rule -->
    <path android:strokeColor="#E24C4B" android:strokeWidth="2.5"
        android:strokeLineCap="round" android:pathData="M41,38 L41,70" />

    <!-- ruled lines -->
    <path android:strokeColor="#9DB6C7" android:strokeWidth="2.8"
        android:strokeLineCap="round" android:pathData="M46,44 L68,44" />
    <path android:strokeColor="#9DB6C7" android:strokeWidth="2.8"
        android:strokeLineCap="round" android:pathData="M46,54 L68,54" />
    <path android:strokeColor="#9DB6C7" android:strokeWidth="2.8"
        android:strokeLineCap="round" android:pathData="M46,64 L56,64" />

    <!-- gold coin -->
    <path android:fillColor="#F6C445"
        android:pathData="M58,68 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0 Z" />
    <path android:strokeColor="#DBA400" android:strokeWidth="2"
        android:pathData="M61.5,68 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0 Z" />
</vector>
