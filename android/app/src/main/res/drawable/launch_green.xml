<?xml version="1.0" encoding="utf-8"?>
<!-- Android's launch window: brand green with the APP ICON at the centre —
     the same picture, size and spot as the system splash (Android 12+) and
     NativeSplash, so nothing jumps between them. Was a shopping-basket tile;
     replaced 2026-11-20 so the opening screen fits every kind of business. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1B5E20" />
        </shape>
    </item>
    <item android:gravity="center" android:width="160dp" android:height="160dp"
        android:drawable="@drawable/splash_app_icon" />
</layer-list>
