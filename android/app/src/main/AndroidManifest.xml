<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
        <!-- NOTE: the FileProvider for cordova-plugin-x-socialsharing
             (…sharing.provider) is declared by the regenerated
             capacitor-cordova-android-plugins module's manifest, so it is NOT
             repeated here (a duplicate authority would break the manifest merge). -->
    </application>

    <!-- Android 11+ package visibility: needed so the PDF-to-WhatsApp share
         (ACTION_SEND with setPackage("com.whatsapp")) can resolve WhatsApp. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Auto-send customer notification SMS from the grocer's phone -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Pick a customer's number from the phone's saved contacts. The contacts
         plugin's "contacts" permission alias bundles READ + WRITE, and the alias
         is only GRANTED when BOTH are declared — so WRITE_CONTACTS is required
         for the picker to open even though we never write contacts. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <!-- Bluetooth receipt printer (ESC/POS over the classic serial profile).
         Android 12 SPLIT the old permissions: BLUETOOTH / BLUETOOTH_ADMIN are
         install-time and only apply up to API 30, while BLUETOOTH_CONNECT is a
         RUNTIME permission from API 31 on. Declaring only the old pair means
         listing paired devices silently returns nothing on any modern phone,
         which reads as "the printer isn't there".
         SCAN is declared because the plugin's discovery path needs it; we only
         use the paired list, hence neverForLocation — this app never derives a
         location from Bluetooth and says so, or the Play review asks why. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
</manifest>
