<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
        <!-- NOTE: the FileProvider for cordova-plugin-x-socialsharing
             (…sharing.provider) is declared by the regenerated
             capacitor-cordova-android-plugins module's manifest, so it is NOT
             repeated here (a duplicate authority would break the manifest merge). -->
    </application>

    <!-- Android 11+ package visibility: needed so the PDF-to-WhatsApp share
         (ACTION_SEND with setPackage("com.whatsapp")) can resolve WhatsApp,
         and so the phone's own messaging app can be resolved for a notice sent
         by SMS. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="sms" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- NO SMS PERMISSION, deliberately. The notice used to be sent in the
         background with SEND_SMS; Google Play restricts that permission to apps
         whose core purpose is messaging (the default SMS handler), so holding it
         made the app unpublishable. A notice now opens the user's own messaging
         app pre-filled, via an `sms:` intent, which needs no permission at all
         (see src/lib/notify.ts). Do not add it back. -->

    <!-- NO CONTACTS PERMISSION, deliberately. Picking a customer's number goes
         through Android's own picker (ACTION_PICK, see ContactPickerPlugin.java),
         which hands back the ONE contact the user chose with a temporary read
         grant for it. READ_CONTACTS would mean access to the whole address book
         at any time, and Play charges for that in prominent disclosure, a
         privacy-policy section and a Data Safety declaration. Do not add it back.
         WRITE_CONTACTS went with it — it was only ever there because the old
         plugin's permission alias refused to work without it. -->

    <!-- Bluetooth receipt printer (ESC/POS over the classic serial profile).
         Android 12 SPLIT the old permissions: BLUETOOTH / BLUETOOTH_ADMIN are
         install-time and only apply up to API 30, while BLUETOOTH_CONNECT is a
         RUNTIME permission from API 31 on. Declaring only the old pair means
         listing paired devices silently returns nothing on any modern phone,
         which reads as "the printer isn't there".
         SCAN is declared because the plugin's discovery path needs it; we only
         use the paired list, hence neverForLocation — this app never derives a
         location from Bluetooth and says so, or the Play review asks why. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- STRIPPED — injected by plugins, never used by this app.
         Location comes from cordova-plugin-bluetooth-serial's discovery path;
         we only ever read the PAIRED device list, which needs no location on any
         API level. Storage comes from cordova-plugin-x-socialsharing; PDFs are
         shared through the FileProvider above, which needs no storage permission.
         Leaving either in place makes Play treat this as a location/storage app
         and pulls both into the Data Safety form for nothing. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"
        tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />

</manifest>